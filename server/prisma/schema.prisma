generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum Role {
  PATIENT
  DOCTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ConsultationMode {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InputMode {
  VOICE
  TEXT
}

enum UrgencyLevel {
  ROUTINE
  SOON
  URGENT
  EMERGENCY
}

enum ConditionSource {
  SELF_REPORTED
  DOCTOR_CONFIRMED
}

enum ConsentType {
  TERMS
  HEALTH_DATA_PROCESSING
  LOCATION_SHARING
  SHARE_SUMMARY_WITH_DOCTOR
}

// ───────────── Auth ─────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient       Patient?
  doctor        Doctor?
  consents      ConsentRecord[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model ConsentRecord {
  id        String      @id @default(uuid())
  userId    String
  type      ConsentType
  granted   Boolean
  version   String      @default("v1")
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────── Patient ─────────────

model Patient {
  id                    String    @id @default(uuid())
  userId                String    @unique
  name                  String
  phone                 String
  address               String
  city                  String
  state                 String?
  pincode               String?
  dateOfBirth           DateTime?
  gender                Gender?
  preferredLanguage     String    @default("en")
  latitude              Float?
  longitude             Float?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conditions    PatientCondition[]
  doctors       Doctor[]           @relation("PatientDoctors")
  healthQueries HealthQuery[]
  appointments  Appointment[]
  savedDoctors  SavedDoctor[]
  reviews       Review[]
   nurseBookings NurseBooking[]
}

model PatientCondition {
  id        String          @id @default(uuid())
  patientId String
  name      String
  notes     String?
  source    ConditionSource @default(SELF_REPORTED)
  since     DateTime?
  createdAt DateTime        @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// ───────────── Doctor ─────────────

model Specialization {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  subSpecializations SubSpecialization[]
  doctors            Doctor[]
  suggestions        QuerySpecialtySuggestion[]
}

model SubSpecialization {
  id               String @id @default(uuid())
  name             String
  specializationId String

  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  doctors        Doctor[]

  @@unique([specializationId, name])
}

model Doctor {
  id                 String             @id @default(uuid())
  userId             String             @unique
  name               String
  phone              String
  specializationId   String
  yearsOfExperience  Int
  clinicName         String?
  address            String
  city               String
  state              String?
  pincode            String?
  latitude           Float?
  longitude          Float?
  bio                String?
  photoUrl           String?
  consultationFee    Decimal            @db.Decimal(10, 2)
  consultationModes  ConsultationMode[]
  languages          String[]
  registrationNumber String
  licensingAuthority String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization     Specialization         @relation(fields: [specializationId], references: [id])
  subSpecializations SubSpecialization[]
  qualifications     DoctorQualification[]
  slots              AvailabilitySlot[]
  appointments       Appointment[]
  patients           Patient[]              @relation("PatientDoctors")
  consultationNotes  ConsultationNote[]
  savedBy            SavedDoctor[]
  recommendations    DoctorRecommendation[]
  reviews            Review[]

  @@unique([registrationNumber, licensingAuthority])
  @@index([specializationId, city])
  @@index([verificationStatus])
}

model DoctorQualification {
  id          String  @id @default(uuid())
  doctorId    String
  degree      String
  institution String
  year        Int?
  isVerified  Boolean @default(false)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// ───────────── Availability and Appointments ─────────────

model AvailabilitySlot {
  id        String           @id @default(uuid())
  doctorId  String
  startsAt  DateTime
  endsAt    DateTime
  mode      ConsultationMode
  createdAt DateTime         @default(now())

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt])
}

model Appointment {
  id                     String            @id @default(uuid())
  patientId              String
  doctorId               String
  slotId                 String?           @unique
  startsAt               DateTime
  endsAt                 DateTime
  healthQueryId          String?
  mode                   ConsultationMode
  status                 AppointmentStatus @default(PENDING)
  reason                 String?
  shareSummaryWithDoctor Boolean           @default(false)
  meetingRoom            String?
  meetingUrl             String?
  cancelledAt            DateTime?
  cancelledBy            Role?
  cancelReason           String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  patient     Patient               @relation(fields: [patientId], references: [id])
  doctor      Doctor                @relation(fields: [doctorId], references: [id])
  slot        AvailabilitySlot?     @relation(fields: [slotId], references: [id])
  healthQuery HealthQuery?          @relation(fields: [healthQueryId], references: [id])
  note        ConsultationNote?
  reminders   AppointmentReminder[]
  review      Review?

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([doctorId, startsAt])
}

model ConsultationNote {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  doctorId      String
  notes         String
  followUp      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id])
}

model AppointmentReminder {
  id            String    @id @default(uuid())
  appointmentId String
  remindAt      DateTime
  sentAt        DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
}

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id])
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

model SavedDoctor {
  patientId String
  doctorId  String
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([patientId, doctorId])
}

// ───────────── Health Query and AI ─────────────

model HealthQuery {
  id                    String       @id @default(uuid())
  patientId             String
  inputMode             InputMode
  language              String
  transcript            String
  extractedData         Json?
  extractionConfirmedAt DateTime?
  urgencyLevel          UrgencyLevel @default(ROUTINE)
  emergencyFlag         Boolean      @default(false)
  createdAt             DateTime     @default(now())

  patient              Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  guidance             QueryGuidance?
  specialtySuggestions QuerySpecialtySuggestion[]
  recommendations      DoctorRecommendation[]
  appointments         Appointment[]

  @@index([patientId, createdAt])
}

model QueryGuidance {
  id              String   @id @default(uuid())
  healthQueryId   String   @unique
  summary         String
  explanation     String
  nextSteps       String
  uncertaintyNote String
  modelName       String?
  createdAt       DateTime @default(now())

  healthQuery HealthQuery           @relation(fields: [healthQueryId], references: [id], onDelete: Cascade)
  sources     QueryGuidanceSource[]
}

model QueryGuidanceSource {
  id         String  @id @default(uuid())
  guidanceId String
  sourceId   String
  claim      String?

  guidance QueryGuidance @relation(fields: [guidanceId], references: [id], onDelete: Cascade)
  source   MedicalSource @relation(fields: [sourceId], references: [id])

  @@index([guidanceId])
}

model QuerySpecialtySuggestion {
  id               String @id @default(uuid())
  healthQueryId    String
  specializationId String
  reason           String

  healthQuery    HealthQuery    @relation(fields: [healthQueryId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id])

  @@unique([healthQueryId, specializationId])
}

model DoctorRecommendation {
  id            String @id @default(uuid())
  healthQueryId String
  doctorId      String
  rank          Int
  score         Float
  reasons       Json

  healthQuery HealthQuery @relation(fields: [healthQueryId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@unique([healthQueryId, doctorId])
}

// ───────────── Medical Knowledge Base ─────────────

model MedicalSource {
  id             String    @id @default(uuid())
  title          String
  organization   String
  url            String    @unique
  language       String    @default("en")
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  chunks        MedicalChunk[]
  guidanceLinks QueryGuidanceSource[]
}

model MedicalChunk {
  id         String @id @default(uuid())
  sourceId   String
  content    String
  chunkIndex Int

  source MedicalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, chunkIndex])
}

// ───────────── Platform ─────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}



  enum NurseBookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model NurseServiceType {
  id              String  @id @default(uuid())
  name            String  @unique
  slug            String  @unique
  description     String
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)
  patientNote     String?
  isActive        Boolean @default(true)

  nurses   Nurse[]
  bookings NurseBooking[]
}

model Nurse {
  id                 String             @id @default(uuid())
  name               String
  phone              String
  city               String
  yearsOfExperience  Int
  qualification      String
  registrationNumber String
  licensingAuthority String
  languages          String[]
  workStartHour      Int                @default(9)
  workEndHour        Int                @default(18)
  verificationStatus VerificationStatus @default(PENDING)
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())

  services NurseServiceType[]
  bookings NurseBooking[]

  @@unique([registrationNumber, licensingAuthority])
  @@index([city, verificationStatus])
}

model NurseBooking {
  id           String             @id @default(uuid())
  patientId    String
  nurseId      String
  serviceId    String
  startsAt     DateTime
  endsAt       DateTime
  address      String
  city         String
  landmark     String?
  notes        String?
  price        Decimal            @db.Decimal(10, 2)
  status       NurseBookingStatus @default(CONFIRMED)
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
    reminderSentAt DateTime?

  patient Patient          @relation(fields: [patientId], references: [id])
  nurse   Nurse            @relation(fields: [nurseId], references: [id])
  service NurseServiceType @relation(fields: [serviceId], references: [id])

  @@index([nurseId, startsAt])
  @@index([patientId, status])
}